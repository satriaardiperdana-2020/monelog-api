APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
HEALTH_READY_TIMEOUT=2s
DATABASE_URL=postgres://monelog:change-me@127.0.0.1:5432/monelog?sslmode=disable
AUTH_JWT_HMAC_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_MINIMUM_SECRET
AUTH_JWT_ISSUER=monelog-api
AUTH_JWT_AUDIENCE=monelog-app
AUTH_ACCESS_TOKEN_TTL=24h
AUTH_ALLOWED_ORIGINS=https://app.example.com
